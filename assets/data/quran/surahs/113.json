{
  "surah_number": 113,
  "basmala_mode": "prefatory",
  "basmala_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "ayahs": [
    {
      "number": 1,
      "arabic": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
      "translation": "Say, \"I seek refuge in the Lord of daybreak",
      "footnotes": "",
      "sajdah": false
    },
    {
      "number": 2,
      "arabic": "مِن شَرِّ مَا خَلَقَ",
      "translation": "From the evil of that which He created",
      "footnotes": "",
      "sajdah": false
    },
    {
      "number": 3,
      "arabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "translation": "And from the evil of darkness when it settles",
      "footnotes": "",
      "sajdah": false
    },
    {
      "number": 4,
      "arabic": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ",
      "translation": "And from the evil of the blowers in knots[2014]",
      "footnotes": "[2014] i.e., those who practice magic.",
      "sajdah": false
    },
    {
      "number": 5,
      "arabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "translation": "And from the evil of an envier when he envies.\"",
      "footnotes": "",
      "sajdah": false
    }
  ]
}
